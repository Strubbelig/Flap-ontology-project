    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24816">
        <rdfs:label>Anterior chest</rdfs:label>
        <obo:IAO_0000115>Subdivision of thorax which is anterior to the plane of the posterior boundary of the middle mediastinum.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_20358"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#regional_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_9576"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24817">
        <rdfs:label>Lateral chest wall</rdfs:label>
        <obo:IAO_0000115>Subdivision of the chest wall which is demarcated from the anterior part of the chest by the anterior axillary lines and form the posterior part of the chest by the posterior axillary lines.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_26073"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24850">
