    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_45562">
        <rdfs:label>Multilaminar epithelium</rdfs:label>
        <obo:IAO_0000115>Epithelium which consists of more than one layer of epithelial cells that may or may not be in contact with a basement membrane. Examples: keratinized stratified squamous epithelium, ciliated stratified columnar epithelium.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9639"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_45563">
        <rdfs:label>Stratified squamous epithelium</rdfs:label>
        <obo:IAO_0000115>Multilaminar epithelium which consists of more than one layer of squamous cells only one layer of which is in contact with a basement membrane. Examples: keratinized stratified squamous epithelium, epithelium of wall of esophagus.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_45562"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_45568">
        <rdfs:label>Keratinized stratified squamous epithelium</rdfs:label>
        <obo:IAO_0000115>Keratinized stratified squamous epithelium is a stratified squamous epithelium, the cells of which synthesize and accumulate keratin.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_45563"/>
    </owl:Class>
