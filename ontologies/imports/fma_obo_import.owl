    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23117">
        <rdfs:label>Branch of deep brachial artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_22693"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23120">
        <rdfs:label>Radial collateral artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_23117"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23159">
        <rdfs:label>Serratus anterior branch of lateral thoracic artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_79661"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23160">
        <rdfs:label>Branch of lateral thoracic artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_70345"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23179">
        <rdfs:label>Circumflex scapular artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_70422"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23193">
        <rdfs:label>Branch of circumflex scapular artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_70422"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23217">
        <rdfs:label>Pectoral girdle</rdfs:label>
        <obo:IAO_0000115>Subdivision of free upper limb, which is the proximal segment of an upper limb and links the free upper limb to the trunk; it is demarcated by the plane of the surface of the glenoid fossa from the free upper limb; together with the free upper limb, it constitutes the upper limb. Examples: There are only two instances, right and left pectoral girdles.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24874"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23220">
        <rdfs:label>Subdivision of pectoral girdle</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9661"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23466">
        <rdfs:label>Ulna</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7474"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24008">
        <rdfs:label>Zone of long bone</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_10483"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24012">
        <rdfs:label>Epiphysis</rdfs:label>
        <obo:IAO_0000115>Subdivision of long bone which forms its expanded proximal or distal articular end; together with other the subdivisions of long bone, it constitutes the long bone. Examples: proximal epiphysis of humerus, distal epiphysis of femur.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24008"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24040">
        <rdfs:label>Inguinal part of abdomen</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_20357"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24137">
        <rdfs:label>Anatomical surface</rdfs:label>
        <obo:IAO_0000115>Anatomical boundary entity which has two spatial dimensions. Examples: body surface, epigastrium, precordium, right iliac fossa.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_50705"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24146">
        <rdfs:label>Body surface region</rdfs:label>
        <obo:IAO_0000115>Anatomical surface, which is the external surface of a body part or a body part subdivision. Examples: surface of head, surface of front of neck, epigastric region, sacral region, surface of dorsum of right foot.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_242980"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24147">
        <rdfs:label>Surface of subdivision of principal body part</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24146"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24176">
        <rdfs:label>Surface of subdivision of free upper limb</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25231"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24217">
        <rdfs:label>Back of thorax</rdfs:label>
        <obo:IAO_0000115>Subdivision of thorax, which is the posterior part of the thorax and is demarcated from the chest by the external surface of the posterolateral part of the rib cage and the anterior surface of the thoracic vertebral column; together with the chest, it constitutes the thorax. Examples: There is only one chest.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_259104"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24218">
        <rdfs:label>Subdivision of head</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_67504"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24219">
        <rdfs:label>Subdivision of neck</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_231430"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24223">
        <rdfs:label>Front of neck</rdfs:label>
        <obo:IAO_0000115>Subdivision of neck, which is demarcated from the back of the neck by the plane of the anterior part of the prevertebral fascia; together with the back of the neck, it constitutes the neck. Examples: There is only one front of neck.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24219"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24226">
        <rdfs:label>Subdivision of pelvis</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_20357"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24479">
        <rdfs:label>Fibula</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7474"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24492">
        <rdfs:label>Metatarsal bone</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7474"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24493">
        <rdfs:label>Phalanx of toe</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_7474"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24503">
        <rdfs:label>Second metatarsal bone</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24492"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24756">
        <rdfs:label>Zone of skin of head</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_86166"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24757">
        <rdfs:label>Skin of scalp</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_59345"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24864">
        <rdfs:label>Axilla</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_23220"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24874">
        <rdfs:label>Limb girdle</rdfs:label>
        <obo:IAO_0000115>Subdivision of limb, which is the proximal segment of a limb and links the free limb to the trunk; it is demarcated by the plane of the surfaces of the glenoid and acetabular fossae from the free limb; together with the free limb, it constitutes the limb. Examples: There are only four instances, right and left pectoral girdles and right and left pelvic girdles.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9661"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24875">
        <rdfs:label>Free limb</rdfs:label>
        <obo:IAO_0000115>Subdivision of limb, which is distal to the limb girdle and demarcated by the plane of the surfaces of the glenoid and acetabular fossae from the limb girdle; together with the limb girdle, it constitutes the limb. Examples: There are only four instances, right and left free upper limbs and right and left free lower limbs.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9661"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24876">
        <rdfs:label>Free upper limb segment</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_241863"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24877">
        <rdfs:label>Free lower limb segment</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_241863"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24878">
        <rdfs:label>Free upper limb</rdfs:label>
        <obo:IAO_0000115>Free limb, which is distal to the pectoral girdle and demarcated by the plane of the surface of the glenoid fossa from the pectoral girdle; together with the pectoral girdle, it constitutes the upper limb. Examples: There are only two instances, right and left free upper limbs.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24875"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24879">
        <rdfs:label>Free lower limb</rdfs:label>
        <obo:IAO_0000115>Free limb, which is distal to the pelvic girdle and demarcated by the plane of the surface of the acetabular fossa from the pelvic girdle; together with the pelvic girdle, it constitutes the lower limb. Examples: There are only two instances, right and left free lower limbs.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24875"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24890">
        <rdfs:label>Arm</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_83014"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24910">
        <rdfs:label>Anterior part of forearm</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24876"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24911">
        <rdfs:label>Posterior part of forearm</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24876"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24945">
        <rdfs:label>Segment of hand</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24876"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24960">
        <rdfs:label>Subdivision of pelvic girdle</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_9661"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24964">
        <rdfs:label>Hip</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24960"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24967">
        <rdfs:label>Thigh</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_83014"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24979">
        <rdfs:label>Leg</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_83016"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24984">
        <rdfs:label>Posterior part of leg</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24988"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24988">
        <rdfs:label>Segment of leg</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24877"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_24993">
        <rdfs:label>Segment of foot</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24877"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25000">
        <rdfs:label>Plantar part of foot</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24993"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25045">
        <rdfs:label>Dorsal part of foot</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24993"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25046">
        <rdfs:label>Toe</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24993"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25047">
        <rdfs:label>Big toe</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25046"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25048">
        <rdfs:label>Second toe</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25046"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25054">
        <rdfs:label>Subdivision of trunk</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_231430"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25056">
        <rdfs:label>Back of trunk</rdfs:label>
        <obo:IAO_0000115>Subdivision of trunk which is demarcated from the trunk proper by the external surface of the posterolateral part of the rib cage, the anterior surface of the thoracic vertebral column and the posterior axillary lines, the external surface of the posterior abdominal wall; together with the trunk proper, it constitutes the trunk. Examples: There is only one trunk proper.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25054"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25072">
        <rdfs:label>Thoracolumbar fascia</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_27935"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25202">
        <rdfs:label>Shoulder</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_23220"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25231">
        <rdfs:label>Surface of limb segment</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24147"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25245">
        <rdfs:label>Buttock</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24960"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25264">
        <rdfs:label>Subdivision of surface of hand</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24176"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25314">
        <rdfs:label>Palmar surface of finger</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25264"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_26073">
        <rdfs:label>Region of chest wall</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_20358"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_27935">
        <rdfs:label>Investing fascia</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_5023"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_30313">
        <rdfs:label>Arterial trunk</rdfs:label>
        <obo:IAO_0000115>Tubular organ part, the wall and lumen of which are continuous with those of the ventricles of the heart, directly or indirectly through branches of the aorta and pulmonary trunk. Examples: bronchial artery, hepatic artery, coronary artery, truncus anterior of right pulmonary artery, aorta.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_86187"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_30314">
        <rdfs:label>Venous trunk</rdfs:label>
        <obo:IAO_0000115>Tubular organ part, the wall and lumen of which are continuous with those of the atria of the heart, directly or indirectly through tributaries of the venae cavae, pulmonary veins and the hepatic and portal veins. Examples: coronary sinus, posterior intercostal vein, hepatic vein, bronchial vein, pulmonary vein, trunk of inferior vena cava.</obo:IAO_0000115>
