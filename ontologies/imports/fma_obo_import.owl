        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#regional_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_223617"/></owl:Restriction></rdfs:subClassOf>
