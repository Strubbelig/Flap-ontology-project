    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_7200">
        <rdfs:label>Small intestine</rdfs:label>
        <obo:IAO_0000115>Organ with organ cavity which is continuous proximally with the stomach and distally with the large intestine. Examples: There is only one small intestine.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_55672"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#constitutional_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_260478"/></owl:Restriction></rdfs:subClassOf>
