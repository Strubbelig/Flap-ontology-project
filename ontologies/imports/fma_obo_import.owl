    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_61707">
        <rdfs:label>Auriculotemporal part of head</rdfs:label>
        <obo:IAO_0000115>Subdivision of head proper which consists of the temporal bone and all layers superficial to it, including the pinna. Examples: There are only two canonical instances, right and left auriculotemporal parts of head.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_58817"/>
    </owl:Class>
