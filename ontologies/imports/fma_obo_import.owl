    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23024">
        <rdfs:label>Skin of scapular part of back</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_23019"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23029">
        <rdfs:label>Zone of skin of thorax</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_23093"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23058">
