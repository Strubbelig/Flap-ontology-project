        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_24879"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#regional_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_7188"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
