    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9908">
        <rdfs:label>Peritoneal sac</rdfs:label>
        <obo:IAO_0000115>Serous sac, which has as parts the peritoneum and the peritoneal cavity. Examples: There is only one peritoneal sac.</obo:IAO_0000115>
