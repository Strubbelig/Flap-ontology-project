    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_65132">
        <rdfs:label>Nerve</rdfs:label>
        <obo:IAO_0000115>Segment of neural tree organ which has as its parts a nerve trunk and its branches; together with other nerves of the same tree it constitutes a neural tree. Examples: chorda tympani, digastric branch of facial nerve, greater petrosal nerve, posterior cutaneous branch of posterior ramus of cervical nerve, superior lateral cutaneous nerve of arm.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_11195"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_65239">
        <rdfs:label>Peripheral nerve</rdfs:label>
        <obo:IAO_0000115>Neural tree (organ) which is directly continuous with the neuraxis. Examples: phrenic nerve, radial nerve, ilioinguinal nerve, sciatic nerve.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_61284"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_65269">
