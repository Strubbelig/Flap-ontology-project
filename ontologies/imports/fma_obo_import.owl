        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_61705"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#regional_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_52781"/></owl:Restriction></rdfs:subClassOf>
