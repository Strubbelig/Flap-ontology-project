        <rdfs:label>Eleventh thoracic nerve</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_5860"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#systemic_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_63159"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_6443">
        <rdfs:label>Second cervical nerve</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_5859"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#systemic_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_63818"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_6871">
        <rdfs:label>Lesser occipital nerve</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_12198"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#branch_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_5904"/></owl:Restriction></rdfs:subClassOf>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#branch_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_7062"/></owl:Restriction></rdfs:subClassOf>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_6872">
        <rdfs:label>Great auricular nerve</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_65239"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#branch_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_5904"/></owl:Restriction></rdfs:subClassOf>
