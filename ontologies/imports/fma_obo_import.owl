<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:obo="http://purl.obolibrary.org/obo/" xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://purl.bioontology.org/ontology/OFL/imports/fma_obo_import.owl">
        <owl:versionIRI rdf:resource="https://purl.bioontology.org/ontology/OFL/2.2.1/imports/fma_obo_import.owl"/>
        <dcterms:source rdf:resource="http://purl.obolibrary.org/obo/fma/releases/2020-04-13/fma.owl"/>
        <dcterms:title>FMA OBO import module for OFL</dcterms:title>
        <rdfs:comment>Module of the OBO version of the FMA (fma_obo.owl, ontology IRI http://purl.obolibrary.org/obo/fma.owl, release 2020-04-13; not the original FMA, http://purl.org/sig/ont/fma.owl) for OFL 2.2.1: the 443 FMA classes referenced by OFL, closed under their named superclasses and the classes they are part_of (regional, constitutional, systemic) or branch_of (1155 classes), with labels, definitions, the subClassOf axioms between them and their 876 part_of and branch_of restrictions, and the FMA OBO object properties part_of, regional_part_of, constitutional_part_of, systemic_part_of, branch_of. Axioms are copied unchanged; other FMA relations (bounds, attaches_to) are not included.</rdfs:comment>
    </owl:Ontology>
