    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23066">
        <rdfs:label>Clavicular branch of thoraco-acromial artery</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_70408"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23093">
        <rdfs:label>Zone of skin of trunk</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_86166"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_23100">
        <rdfs:label>Skin of limb</rdfs:label>
