    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_3710">
        <rdfs:label>Vascular tree</rdfs:label>
        <obo:IAO_0000115>Hollow tree, the organ parts of which are arteries, veins or lymphatic vessels. Examples: systemic arterial tree (organ), portal venous tree (organ), thoracic duct tree.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_55677"/>
    </owl:Class>
