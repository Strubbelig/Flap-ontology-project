    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9616">
        <rdfs:label>Muscle of head</rdfs:label>
        <obo:IAO_0000115>Muscle organ which is a part of the head. Examples: masseter, orbicularis oculi.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_5022"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9617">
        <rdfs:label>Muscle of neck</rdfs:label>
        <obo:IAO_0000115>Muscle organ which is a part of the neck. Examples: platysma, sternocleidomastoid, cricothyroid muscle.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_5022"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9619">
        <rdfs:label>Muscle of thorax</rdfs:label>
        <obo:IAO_0000115>Muscle organ which is a part of the thorax. Examples: external intercostal muscle, diaphragm.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_58274"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9620">
        <rdfs:label>Muscle of abdomen</rdfs:label>
        <obo:IAO_0000115>Muscle (organ) which is a part of the abdomen. Examples: external oblique, rectus abdominis.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_58274"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_9621">
        <rdfs:label>Muscle of upper limb</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_5022"/>
