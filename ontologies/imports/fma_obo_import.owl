        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_42603"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_32406">
        <rdfs:label>Organ cluster</rdfs:label>
        <obo:IAO_0000115>Anatomical cluster which consists of all or some members of one or more organ subclasses which are grouped together according to some shared attributes. Examples: abdominal viscera, pelvic viscera.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_49443"/>
    </owl:Class>
