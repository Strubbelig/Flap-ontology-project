    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25055">
        <rdfs:label>Trunk proper</rdfs:label>
        <obo:IAO_0000115>Subdivision of trunk which is demarcated from the back of trunk by the external surface of the posterolateral part of the rib cage, the anterior surface of the thoracic vertebral column and the posterior axillary lines, the external surface of the posterior abdominal wall and from the limbs by the inguinal folds; together with the back of trunk, it constitutes the trunk. Examples: There is only one trunk proper.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25054"/>
    </owl:Class>
    <owl:Class rdf:about="http://purl.obolibrary.org/obo/FMA_25056">
        <rdfs:label>Back of trunk</rdfs:label>
        <obo:IAO_0000115>Subdivision of trunk which is demarcated from the trunk proper by the external surface of the posterolateral part of the rib cage, the anterior surface of the thoracic vertebral column and the posterior axillary lines, the external surface of the posterior abdominal wall; together with the trunk proper, it constitutes the trunk. Examples: There is only one trunk proper.</obo:IAO_0000115>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/FMA_25054"/>
        <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/fma#regional_part_of"/><owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/FMA_14181"/></owl:Restriction></rdfs:subClassOf>
