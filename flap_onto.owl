<owl:Class rdf:about="https://purl.bioontology.org/ontology/OFL/OFLID1000103">
  <rdfs:subClassOf rdf:resource="https://purl.bioontology.org/ontology/OFL/OFLID1000093"/>
  <x_1.1:description rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A chimeric flap may consist of any combination of types I, II or III. Cases with mixed types I to III are type IV. A subscript notation in brackets indicates the specifix type, for example: Type IV (I+II).</x_1.1:description>
  <rdfs:label xml:lang="en">Type IV: mixed chimerism</rdfs:label>
</owl:Class>

