    <rdfs:subClassOf rdf:nodeID="Nff73bf419f6d4d10abdf8c6195119497"/>
    <rdfs:subClassOf rdf:nodeID="N75b373556ddb487a96b28d79a8aca7fb"/>
    <fma:definition>A graft is a segment of healthy tissue transplanted from one area of a person's body to another. Unlike a flap, a graft initially relies solely on diffusion for nourishment, and its blood supply is later established through neovascularization—primarily via newly formed capillary networks—which develops a significant time after transplantation.</fma:definition>
    <rdfs:label xml:lang="en">Surgical graft</rdfs:label>
    <owl:equivalentClass rdf:resource="https://purl.bioontology.org/ontology/OFL/OFLID1000184"/>
    <owl:sameAs rdf:resource="https://purl.bioontology.org/ontology/OFL/OFLID1000184"/>
  </rdf:Description>
