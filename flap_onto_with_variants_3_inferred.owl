    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://purl.bioontology.org/ontology/OFL/OFLID1000149"/>
    <rdfs:subClassOf rdf:nodeID="N52de17dcb1634d20a8213da72bcc0f40"/>
