    <rdfs:subClassOf rdf:nodeID="N52de17dcb1634d20a8213da72bcc0f40"/>
    <obo:IAO_0000115>Flap surgery involves transporting healthy, live tissue from one location of the body to another - often to areas that have lost skin, fat, muscle movement, and/or skeletal support. There are several different types of flaps that may be utilized, depending upon the location of the flap and the structures that need to be repaired.</obo:IAO_0000115>
    <obo:IAO_0000119>https://stanfordhealthcare.org/medical-treatments/p/plastic-surgery/procedures/flap.html 
retrieved 27.5.2025, 19:56</obo:IAO_0000119>
    <rdfs:label xml:lang="en">Surgical flap</rdfs:label>
    <owl:equivalentClass rdf:resource="https://purl.bioontology.org/ontology/OFL/OFLID10002"/>
    <owl:sameAs rdf:resource="https://purl.bioontology.org/ontology/OFL/OFLID10002"/>
  </rdf:Description>
