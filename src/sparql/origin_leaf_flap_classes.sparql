PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX ofl:  <https://purl.bioontology.org/ontology/OFL/>

# All leaf classes under ORIGIN_ROOT (flaps with no named subclasses).
# Used in Phase 2 of ABox generation for flaps that lack explicit hasPart data.
SELECT DISTINCT ?flap ?flapLabel WHERE {
  ?flap rdfs:subClassOf* ofl:OFLID10098 .
  ?flap rdfs:label ?flapLabel .
  FILTER(!isBlank(?flap))
  FILTER(STRSTARTS(STR(?flap), "https://purl.bioontology.org/ontology/OFL/"))
  FILTER NOT EXISTS {
    ?sub rdfs:subClassOf ?flap .
    FILTER(!isBlank(?sub))
    FILTER(isIRI(?sub))
  }
}
